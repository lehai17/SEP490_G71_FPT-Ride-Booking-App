# Web can use localhost. Android emulator reaches the host machine through 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:5228/api
# Optional platform overrides:
# EXPO_PUBLIC_API_URL_WEB=http://localhost:5228/api
# EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:5228/api
# EXPO_PUBLIC_API_URL_IOS=http://localhost:5228/api
EXPO_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key_here
EXPO_PUBLIC_VIETMAP_API_KEY=your_vietmap_api_key_here
